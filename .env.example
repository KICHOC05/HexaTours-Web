# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local or send it through chat, tickets, or logs.

SPRING_PROFILES_ACTIVE=local

DB_HOST=your-database-host
DB_PORT=3306
DB_NAME=your-database-name
DB_USERNAME=your-database-user
DB_PASSWORD=replace-with-a-secret
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false
DB_USE_SSL=true
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000

# Use update only for disposable/local development environments.
JPA_DDL_AUTO=update

# Generate at least 32 random bytes for this key.
APP_REMEMBER_ME_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false

# Login rate limit: 5 failed attempts per IP in 15 minutes, then block for 15 minutes.
APP_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
APP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
APP_LOGIN_RATE_LIMIT_BLOCK_SECONDS=900

# Local-only, idempotent test administrator.
APP_SEED_ENABLED=true
APP_SEED_NAME=Local Test Administrator
APP_SEED_EMAIL=admin.local@example.test
APP_SEED_PASSWORD=replace-with-a-strong-local-password
APP_SEED_ROLE=ROLE_ADMIN

# Cloudinary SDK connection string.
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
